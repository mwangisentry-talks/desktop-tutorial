   "source": [
    "def modifyFruits(matunda):\n",
    "    matundaSet = set(matunda)\n",
    "    matundaSet.add(\"ndizi\")\n",
    "    matundaSet.remove(\"papai\")\n",
    "    listMatunda = list(matundaSet)\n",
    "    return listMatunda[1]\n",
    "\n",
    "\n",
    "matunda= ['Nanasi', 'ndizi', 'papai']\n",
    "\n",
    "print(modifyFruits(matunda))"
   ]
